# ── Slack ──────────────────────────────────────────────────────────────────
SLACK_ENABLED=true
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_DIGEST_CHANNEL=ioc-check

# ── Discord (optional) ──────────────────────────────────────────────────────
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_DIGEST_CHANNEL=   # channel ID (integer), e.g. 123456789012345678

# ── Container DNS (optional) ────────────────────────────────────────────────
# Docker snapshots the host's /etc/resolv.conf into each container at creation
# time and never refreshes it, so a long-running bot can be left pointed at a
# dead resolver if the host's active DNS later changes. docker-compose.yml
# pins DNS_SERVER_1/2 explicitly to avoid that. Defaults to public resolvers;
# override here only if your network blocks outbound DNS to third-party
# resolvers (some routers/ISPs silently drop UDP/53 to non-local servers while
# still allowing normal HTTPS) — point these at whatever resolver the host
# itself successfully uses (check the host's own /etc/resolv.conf).
# DNS_SERVER_1=1.1.1.1
# DNS_SERVER_2=8.8.8.8

# ── Threat Intel API Keys ───────────────────────────────────────────────────
# Leave blank to disable that provider (free providers need no key at all)
VT_API_KEY=
SHODAN_API_KEY=
GREYNOISE_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
IPINFO_API_KEY=
ABUSECH_API_KEY=    # Free key from https://auth.abuse.ch — used by URLhaus + ThreatFox

# ── OSINT API Keys ──────────────────────────────────────────────────────────
# crt.sh and CIRCL PDNS are free with no key required
HIBP_API_KEY=           # Have I Been Pwned — https://haveibeenpwned.com/API/Key
WHOISXML_API_KEY=       # Optional — lifts WHOIS rate limits; falls back to free RDAP without key
CIRCL_PDNS_KEY=         # "username:password" — free account at https://www.circl.lu/services/passive-dns/

# ── LLM for daily digest ────────────────────────────────────────────────────
# Under docker-compose, the backend is selected by COMPOSE_PROFILES below — the
# profile both starts the right container AND sets LLM_PROVIDER for you, so the
# LLM_PROVIDER / CLI_COMMAND values here are only used when running OUTSIDE Docker.
#
# Pick exactly ONE digest LLM backend by setting the compose profile:
#   ollama  → local Ollama container (default, free)
#   codex   → bot image with the Codex CLI baked in (bills your Codex sub)
#   claude  → bot image with the Claude Code CLI baked in (bills your Claude sub)
# Switching backend: change this value, then `docker compose down && docker compose up -d --build`.
COMPOSE_PROFILES=ollama

# Required for the codex/claude profiles ONLY: the host directory that CONTAINS
# your .codex and/or .claude credential folder (usually your home directory).
# The matching folder is mounted into the bot so the CLI reuses your existing
# login — no API key needed. Leave blank for the ollama profile.
#   Linux/macOS:  CLI_AUTH_DIR=/home/youruser      (or ${HOME})
#   Windows:      CLI_AUTH_DIR=C:\Users\youruser
# Note: only file-based logins transfer (codex ~/.codex/auth.json, claude
# ~/.claude/.credentials.json). A macOS-Keychain Claude login won't — run
# `claude setup-token` / `codex login` on a host that writes the file.
CLI_AUTH_DIR=

# "ollama"    — local, free (default). Requires Ollama running on your machine.
# "anthropic" — paid Claude API.
# "cli"       — headless Claude Code / Codex CLI; bills against your CLI
#               subscription. The codex/claude compose profiles bake the CLI
#               into the bot image; outside Docker the CLI must be on PATH.
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
# Default below assumes the bundled docker-compose ollama service.
# If you're running Ollama on your host machine instead, change to: http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma2:2b

# Anthropic settings (only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# CLI settings (only used when LLM_PROVIDER=cli)
# "claude" for the Claude Code CLI, or "codex" for the Codex CLI, or a full path.
CLI_COMMAND=claude
