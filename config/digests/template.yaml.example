# Copy to my-topic.yaml (committed) or my-topic.local.yaml (private).
# Restart the bot after adding/editing topic files.
name: "My Custom Topic"
tags: [mytag]                     # unique across topics
schedule: "0 9,16 * * *"          # digest.timezone; use mon-fri for weekdays
digest_channel: "#my-channel"    # Slack ID/name; Discord numeric channel ID
top_stories_count: 5
keywords: ["local LLM", "ransomware"]
exclude_keywords: ["sponsored"]
# lookback: "7d"                 # initial import only; default digest.bootstrap_days
# profile:                       # optional override of digest.profile fields
#   products: ["Linux"]
#   minimum_score: 2.5
sources:
  - name: "My Source"
    url: "https://example.com/feed.xml"

# Collection is independent of the posting schedule and continues overnight.
# Keywords use word boundaries. YAML lists seed initial values only; use
# !digest keywords <topic> add/remove/exclude/unexclude to edit them later.
# Full text is fetched after ranking; unavailable text is labelled as an excerpt.
# Links and article IDs come from ingestion, never the model.
#
# Optional urgent alert topic instead of a regular digest:
# watch_mode: true
# poll_interval_minutes: 15
# alert_keywords: ["actively exploited", "emergency patch"]
# Both personal relevance and explicit alert_keywords must match.
# Quiet hours apply to posting; collection continues in the background.
